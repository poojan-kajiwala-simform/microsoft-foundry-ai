{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rag": {
    "AppName": "LocalRagAssistant",
    "ChatModelAlias": "phi-3.5-mini",
    "EmbeddingModelAlias": "qwen3-embedding-0.6b",
    "Chunking": "Structured",
    "ChunkSizeWords": 300,
    "ChunkOverlapWords": 40,
    "TopK": 4,
    "CandidateCount": 20,
    "HybridSearch": true,
    "MinSimilarity": 0.40,
    "MaxContextTokens": 1500,
    "MaxAnswerTokens": 400,
    "Temperature": 0.1,
    "DocumentsFolder": "./Documents",
    "DatabasePath": "data/rag.db",
    "MaxFileBytes": 20971520,
    "MaxChunksPerDocument": 2000,
    "EmbeddingBatchSize": 16,
    "RegisterExecutionProviders": true
  }
}
